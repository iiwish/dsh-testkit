{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-testkit.dev/schemas/scenario-v1.json",
  "title": "DSH Testkit Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "subject", "dsh"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "suite": { "enum": ["quick", "full"], "default": "quick" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "updateFrom": { "type": "string", "minLength": 1 }
      }
    },
    "dsh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" }
      }
    },
    "profile": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "default": "dsh-testkit" },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boot": { "enum": ["success", "failure"], "default": "success" },
        "rows": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "services": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "http": {
      "$ref": "#/$defs/httpRoutes"
    },
    "browser": {
      "$ref": "#/$defs/browser"
    },
    "exercise": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "arguments"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "arguments": { "type": "object" }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onBootFailure": { "enum": ["remove-plugin", "none"], "default": "remove-plugin" }
      }
    },
    "observers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": { "$ref": "#/$defs/observerRequirement" },
        "process": { "$ref": "#/$defs/observerRequirement" },
        "ports": { "$ref": "#/$defs/observerRequirement" },
        "network": { "$ref": "#/$defs/observerRequirement" },
        "canary": { "$ref": "#/$defs/observerRequirement" }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "installMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "bootMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "cleanupMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "overallMs": { "type": "integer", "minimum": 5000, "maximum": 3600000, "default": 600000 }
      }
    }
  },
  "$defs": {
    "observerRequirement": { "enum": ["required", "preferred", "off"] },
    "httpRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/httpRoute" },
          "uniqueItems": true
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128 },
        "method": { "const": "GET", "default": "GET" },
        "path": {
          "type": "string",
          "pattern": "^\\/(?:[A-Za-z0-9._~!$&'()*+,;=:@%\\/-]*)$"
        },
        "expect": { "$ref": "#/$defs/httpRouteExpectation" }
      }
    },
    "httpRouteExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599, "default": 200 },
        "json": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke"],
      "properties": {
        "smoke": { "$ref": "#/$defs/browserSmoke" }
      }
    },
    "browserSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expectedText"],
      "properties": {
        "kind": { "const": "turn-status-text" },
        "path": { "type": "string", "pattern": "^\\/(?:[A-Za-z0-9._~!$&'()*+,;=:@%\\/-]*)$", "default": "/" },
        "expectedText": { "type": "string", "minLength": 1, "maxLength": 512 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000, "default": 5000 }
      }
    }
  }
}
