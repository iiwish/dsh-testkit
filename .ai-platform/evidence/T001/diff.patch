diff --git a/package.json b/package.json
new file mode 100644
index 0000000..c16f027
--- /dev/null
+++ b/package.json
@@ -0,0 +1,44 @@
+{
+  "name": "dsh-testkit",
+  "version": "0.1.0",
+  "description": "Real-host lifecycle testing for DeepSeek Harness plugins.",
+  "type": "module",
+  "license": "MIT",
+  "engines": {
+    "node": ">=22"
+  },
+  "packageManager": "pnpm@11.1.3",
+  "bin": {
+    "dsh-test": "dist/src/cli.js"
+  },
+  "exports": {
+    ".": "./dist/src/index.js"
+  },
+  "files": [
+    "dist/src",
+    "assets",
+    "README.md",
+    "LICENSE"
+  ],
+  "scripts": {
+    "build": "tsc -p tsconfig.json",
+    "typecheck": "tsc -p tsconfig.json --noEmit",
+    "test": "vitest run",
+    "test:unit": "vitest run tests/unit",
+    "test:integration": "vitest run tests/integration",
+    "test:e2e": "vitest run tests/e2e/real-dsh.test.ts",
+    "test:pack": "node tests/e2e/pack-consumer.mjs",
+    "validate": "pnpm typecheck && pnpm test && pnpm build"
+  },
+  "dependencies": {
+    "commander": "^15.0.0",
+    "xmlbuilder2": "^4.0.3",
+    "yaml": "^2.8.1",
+    "zod": "^4.1.5"
+  },
+  "devDependencies": {
+    "@types/node": "^24.3.0",
+    "typescript": "^5.9.2",
+    "vitest": "^3.2.4"
+  }
+}
