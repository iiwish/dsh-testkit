+    })
+
+    expect(scenario).toMatchObject({
+      schemaVersion: 1,
+      name: 'dsh-plugin-quick',
+      suite: 'quick',
+      subject: { source: '.' },
+      dsh: { version: '0.1.0-rc.6' },
