diff --git a/assets/runner.Dockerfile b/assets/runner.Dockerfile
new file mode 100644
index 0000000..fe796ec
--- /dev/null
+++ b/assets/runner.Dockerfile
@@ -0,0 +1,24 @@
+FROM node:22-bookworm-slim
+
+ARG TESTKIT_VERSION=development
+ENV COREPACK_HOME=/opt/corepack
+
+RUN apt-get update \
+  && apt-get install -y --no-install-recommends ca-certificates g++ git iproute2 make procps python3 \
+  && rm -rf /var/lib/apt/lists/* \
+  && corepack enable \
+  && mkdir -p /opt/corepack \
+  && corepack prepare pnpm@11.1.3 --activate
+
+WORKDIR /opt/dsh-testkit
+COPY package.json pnpm-workspace.yaml ./
+COPY assets/runner-pnpm-lock.yaml ./pnpm-lock.yaml
+RUN pnpm install --prod --frozen-lockfile
+COPY dist ./dist
+
+ENV DSH_TESTKIT_RUNNER=docker
+ENV DSH_TESTKIT_IMAGE=dsh-testkit-runner:${TESTKIT_VERSION}
+ENV DSH_TESTKIT_WORK_ROOT=/work/run
+ENV DSH_TESTKIT_COREPACK_HOME=/opt/corepack
+ENV HOME=/work/user-home
+ENTRYPOINT ["node", "/opt/dsh-testkit/dist/src/worker/main.js"]
diff --git a/package.json b/package.json
new file mode 100644
index 0000000..dead1aa
--- /dev/null
+++ b/package.json
@@ -0,0 +1,59 @@
+{
+  "name": "dsh-testkit",
+  "version": "0.1.0",
+  "description": "Real-host lifecycle testing for DeepSeek Harness plugins.",
+  "keywords": [
+    "deepseek",
+    "dsh",
+    "harness",
+    "plugin-testing",
+    "lifecycle-testing"
+  ],
+  "type": "module",
+  "license": "MIT",
+  "engines": {
+    "node": ">=22"
+  },
+  "packageManager": "pnpm@11.1.3",
+  "bin": {
+    "dsh-test": "dist/src/cli.js"
+  },
+  "exports": {
+    ".": "./dist/src/index.js",
+    "./schemas/report-v1.json": "./schemas/report-v1.json",
+    "./schemas/scenario-v1.json": "./schemas/scenario-v1.json"
+  },
+  "files": [
+    ".dockerignore",
+    "dist/src",
+    "assets",
+    "pnpm-workspace.yaml",
+    "schemas",
+    "README.md",
+    "LICENSE"
+  ],
+  "scripts": {
+    "build": "tsc -p tsconfig.json",
+    "check:contracts": "node scripts/check-published-contracts.mjs",
+    "check:runner-lock": "node scripts/check-runner-lock.mjs",
+    "typecheck": "tsc -p tsconfig.json --noEmit",
+    "test": "vitest run",
+    "test:unit": "vitest run tests/unit",
+    "test:integration": "vitest run tests/integration",
+    "test:e2e": "pnpm build && DSH_TESTKIT_E2E=1 vitest run tests/e2e/real-dsh.test.ts",
+    "test:pack": "node tests/e2e/pack-consumer.mjs",
+    "validate": "pnpm check:runner-lock && pnpm check:contracts && pnpm typecheck && pnpm test && pnpm build",
+    "prepack": "pnpm check:runner-lock && pnpm check:contracts && pnpm build"
+  },
+  "dependencies": {
+    "commander": "15.0.0",
+    "xmlbuilder2": "4.0.3",
+    "yaml": "2.9.0",
+    "zod": "4.4.3"
+  },
+  "devDependencies": {
+    "@types/node": "24.13.3",
+    "typescript": "5.9.2",
+    "vitest": "3.2.7"
+  }
+}
