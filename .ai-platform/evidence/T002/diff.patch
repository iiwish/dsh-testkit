+      "properties": {
+        "id": { "enum": ["resolve", "install-dsh", "package", "install-plugin", "assemble", "boot", "register", "exercise", "update", "uninstall", "reboot", "recover", "cleanup"] },
+        "status": { "enum": ["passed", "failed", "skipped", "unsupported"] },
+        "startedAt": { "type": "string", "format": "date-time" },
